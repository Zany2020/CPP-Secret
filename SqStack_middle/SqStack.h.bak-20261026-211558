#pragma once
#include<iostream>

constexpr auto OK = 1;
constexpr auto ERROR = 0;
constexpr auto STACK_OVERFLOW = -1;
//constexpr auto TRUE = 1;
//constexpr auto FALSE = 0;

constexpr auto INIT_STACK_SIZE = 100;
constexpr auto STAKE_INCREMENT = 10;

//typedef 给类型起别名
typedef int Status;  //函数返回类型状态

int getIsp(char op)
{
    switch (op)
    {
    case'#': return 0;
    case'(': return 1;
    case'+':
    case'-': return 2;
    case'*':
    case'/': return 4;
    case')': return 6;
    default:return -1;
    }
}

int getIcp(char op)
{
    switch (op)
    {
    case'#': return 0;
    case'(': return 6;
    case'+':
    case'-': return 2;
    case'*':
    case'/': return 4;
    case')': return 1;
    default:return -1;
    }
}
template<typename T>
// 模板顺序栈：T可以是任意类型，这里我们用int和char
class SqStack
{
private:
	T* base;//栈底指针
	    int top; //栈顶指针
	int stacksize; // 栈大小

public:
	SqStack();
	~SqStack();

	Status InitStack(); //初始化
	Status StackEmpty() const;//判断是否为空
	Status StackFull() const;//判断是否为满
	Status Push(T e);// 元素入栈
	Status Pop(T* e);// 栈顶元素出栈，e带回结果
	Status GetTop(T* e) const;
	void Traverse() const;// 遍历栈（栈底→栈顶输出）
	void ClearStack(); // 清空栈（保留内存）
	void DestroyStack(); // 销毁栈（释放内存）


};



