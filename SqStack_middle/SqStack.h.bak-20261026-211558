template<typename T>
SqStack<T>::SqStack()
{
    base = NULL;
    top = 0;
    stacksize = 0;
}

// 析构函数
template<typename T>
SqStack<T>::~SqStack()
{
    DestroyStack();
}

// 初始化栈
template<typename T>
Status SqStack<T>::InitStack()
{
    if (base != NULL)
    {
        DestroyStack();
    }
    base = new T[INIT_STACK_SIZE];
    if (!base)
    {
        exit(STACK_OVERFLOW);
    }
    top = 0;
    stacksize = INIT_STACK_SIZE;
    return OK;
}

// 判断栈空
template<typename T>
Status SqStack<T>::StackEmpty() const
{
    return top == 0 ? 1 : 0;
}

// 判断栈满
template<typename T>
Status SqStack<T>::StackFull() const
{
    return top == stacksize ? 1 : 0;
}

// 元素入栈（满则自动扩容）
template<typename T>
Status SqStack<T>::Push(T e)
{
    if (StackFull())
    {
        int newSize = stacksize + STAKE_INCREMENT;
        T* newBase = new T[newSize];
        if (!newBase)
        {
            exit(STACK_OVERFLOW);
        }
        for (int i = 0; i < top; ++i)
        {
            newBase[i] = base[i];
        }
        delete[] base;
        base = newBase;
        stacksize = newSize;
    }
    base[top] = e;
    top++;
    return OK;
}

// 栈顶元素出栈
template<typename T>
Status SqStack<T>::Pop(T* e)
{
    if (StackEmpty())
    {
        return ERROR;
    }
    top--;
    *e = base[top];
    return OK;
}

// 取栈顶元素
template<typename T>
Status SqStack<T>::GetTop(T* e) const
{
    if (StackEmpty())
    {
        return ERROR;
    }
    *e = base[top - 1];
    return OK;
}

// 遍历输出栈
template<typename T>
void SqStack<T>::Traverse() const
{
    if (StackEmpty()) {
        std::cout << "栈为空，无元素可遍历" << std::endl;
        return;
    }
    std::cout << "栈中元素（栈底 -> 栈顶）：";
    for (int i = 0; i < top; i++) {
        std::cout << base[i] << " ";
    }
    std::cout << std::endl;
}

// 清空栈
template<typename T>
void SqStack<T>::ClearStack()
{
    top = 0;
}

// 销毁栈
template<typename T>
void SqStack<T>::DestroyStack()
{
    if (base != NULL)
    {
        delete[] base;
        base = NULL;
    }
    top = 0;
    stacksize = 0;
}
